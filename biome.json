{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"linter": {
		"enabled": true,
		"rules": { "preset": "none" }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"assist": {
		"actions": {
			"source": { "organizeImports": "on" }
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "spe/evals/**/*.ts", "spe/evals/**/*.mjs"]
	}
}
